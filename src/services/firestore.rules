rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. PRODUCTS COLLECTION
    // Anyone can read products. Admins & Delivery boys (for stock decrement) can update.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'deliveryboy'
      );
    }

    // 2. CART COLLECTION
    // Users can read and write their own cart
    match /cart/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    // 3. ORDERS COLLECTION
    // - Customers can create orders and read their own orders.
    // - Admins and Delivery Partners can read and manage orders in real-time.
    match /orders/{orderId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'deliveryboy'
      );

      allow update: if request.auth != null && (
        // Customer can update their own order (e.g., cancel & refund within 60s)
        request.auth.uid == resource.data.userId ||
        // Admin can update any order
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // Delivery partner can accept orders, update status to Delivered, and verify OTP
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'deliveryboy'
      );

      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 4. USERS COLLECTION
    // Users can read/write their own user profile & wallet. Admins have full access.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'deliveryboy'
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

  }
}